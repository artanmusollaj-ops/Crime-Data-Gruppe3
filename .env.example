# Optional Socrata application token. Public PoC requests also work without it,
# but authenticated requests generally receive higher rate limits.
SOCRATA_APP_TOKEN=

# Required later for ACS enrichment. Never commit the real key.
CENSUS_API_KEY=
# --- Datenablage -----------------------------------------------------------
# local  = lesen und schreiben unter LOCAL_DATA_ROOT (der bisherige Zustand)
# hybrid = lesen lokal zuerst, sonst SeaweedFS; schreiben lokal, pruefen,
#          dann gezielt nach SeaweedFS publizieren
# s3     = lesen immer von SeaweedFS; schreiben lokal als Arbeitskopie,
#          pruefen, publizieren, lokale Kopie entfernen
STORAGE_BACKEND=local

LOCAL_DATA_ROOT=data

# SeaweedFS ueber S3 - nur fuer s3 und hybrid. Schluessel nie committen.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=urban-crime
S3_USE_SSL=true

# Hybrid: vorerst nur "local" als Leseprioritaet; Publizieren nach dem
# Schreiben laesst sich abschalten (dann bleibt alles lokal).
HYBRID_READ_PRIORITY=local
HYBRID_PUBLISH_AFTER_WRITE=true

# --- DuckDB-Grenzen --------------------------------------------------------
# Ohne Angabe nimmt DuckDB rund 80 % des Arbeitsspeichers der Maschine. Auf
# einem Rechner, der nur die Strecke faehrt, ist das richtig. Auf einer
# geteilten Maschine - etwa srv01 mit 7,7 GiB und fuenfzehn Diensten - ist es
# die Stelle, an der ein Mehrjahreslauf stirbt und die Nachbardienste
# mitnimmt. Im Container beides setzen, unterhalb des Container-Limits.
DUCKDB_MEMORY_LIMIT=
DUCKDB_THREADS=

# --- Dienstadressen --------------------------------------------------------
# Ohne Angabe gelten die verschobenen Ports des Entwicklungsrechners
# (18123, 19200, 15601). Im Compose-Verbund heissen die Dienste nach ihrem
# Namen im Netz - etwa http://elasticsearch:9200 -, und ein Container tippt
# kein --url. Ein getipptes --url sticht diese Angaben weiterhin.
CLICKHOUSE_URL=
ELASTICSEARCH_URL=
KIBANA_URL=

# --- Abbilder des Stapels --------------------------------------------------
# Nur fuer docker-compose.srv01.yml. Die Beschreibung dort traegt kein build:,
# weil srv01 den Bau auf dem Host verbietet; gebaut wird auf einem
# Entwicklungsrechner und geschoben. Gepinnt wird per SHA-256-Digest, nicht
# per Marke - eine Marke laesst sich umhaengen, ein Digest nicht. Ohne Angabe
# gilt der lokal gebaute Name, und auf srv01 findet der Stapel nichts.
# Der Entwicklungsrechner ist arm64, srv01 ist x86-64: Ohne
# --platform linux/amd64 beim Bau laesst sich das Abbild anstandslos
# schieben und scheitert erst dort beim Start.
PIPELINE_IMAGE=
JUPYTER_IMAGE=

# E-5, Jupyter im srv01-Verbund: nach erfolgreichem Konsolen-Aufbau setzen.
# Der gewaehlte Job muss vollstaendige Daten und .analyse/stand.json enthalten.
# Beispielwert (durch echte Job-ID ersetzen): /app/data/admin/jobs/<Job-ID>/data
# Leer: /app/data. Vorhandene Notebook-Kopien werden nicht aktualisiert.
CRIME_ANALYSIS_ROOT=

# --- Nicht hierher: PROJECT_ROOT und GIT_COMMIT ----------------------------
# Beide setzt das Abbild selbst (siehe Dockerfile). PROJECT_ROOT ist das
# Verzeichnis mit pyproject.toml und config/ - auf einem Entwicklungsrechner
# wird es an diesen Kennzeichen erkannt und braucht keine Angabe. GIT_COMMIT
# kommt beim Bau als --build-arg herein, damit die Herkunftsangabe erhalten
# bleibt, obwohl .git/ nicht ins Abbild gehoert. In einer .env waeren beide
# eine Fehlerquelle: Sie wuerden auch dann gelten, wenn das Projekt umzieht.
