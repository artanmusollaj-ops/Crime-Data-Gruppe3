# Die erzeugte Code-Referenz (docs/referenz/) wird mit LF abgelegt, egal auf
# welchem System sie gebaut wurde. Ohne diese Regel legte ein Windows-Rechner
# sie mit CRLF ab, und der Waechter, der die abgelegten Bytes gegen einen
# frischen Bau haelt, waere auf der jeweils anderen Plattform rot - ohne dass
# sich eine Zeile Docstring geaendert haette.
docs/referenz/** text eol=lf

# Dasselbe fuer die ausgefuehrten Notebooks: nachweis.json nennt den SHA-256
# jeder HTML-Datei, und tests/test_nachweise.py haelt ihn gegen die Bytes.
# Ohne die Regel checkte der Windows-Lauf sie mit CRLF aus, und alle sechs
# Hashes waren dort falsch (Lauf 42364142333, 7.11.2026).
docs/nachweise/** text eol=lf

# Linux-Einstiege muessen auch nach einem Windows-Checkout ausfuehrbar sein.
docker/*.sh text eol=lf

# Bewusst nur hier und fuer docker/*.sh. Die Crosswalks unter config/ sind
# mit CRLF abgelegt, so wie die Werkzeuge sie aus den amtlichen PDFs
# schreiben; drei Tests vergleichen diese Bytes. Eine eol-Regel darueber
# wuerde sie beim naechsten Checkout umschreiben und die Reproduktion brechen.
